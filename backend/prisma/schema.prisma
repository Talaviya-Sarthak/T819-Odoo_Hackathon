generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// ─── CORE MODELS ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  name          String?   @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  role          UserRole  @default(CUSTOMER)
  avatarUrl     String?   @map("avatar_url") @db.Text
  emailVerified Boolean   @default(false) @map("email_verified")
  status        String    @default("active") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  salesRepresentative  Customer[]     @relation("SalesRep")
  ownedCustomers       Customer[]     @relation("CustomerOwner")
  createdQuotations    Quotation[]    @relation("QuotationCreator")
  approvalRequests     ApprovalRequest[] @relation("Approver")
  approvalHistories    ApprovalHistory[] @relation("ApprovalActionUser")
  auditLogs            AuditLog[]     @relation("AuditUser")

  @@map("users")
}

model CustomerTier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  discountPct Decimal  @default(0) @db.Decimal(5, 2) @map("discount_pct")
  createdAt  DateTime @default(now()) @map("created_at")

  customers        Customer[]
  priceLists       PriceList[]
  discountRules    DiscountRule[]

  @@map("customer_tiers")
}

model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(255)
  company      String?      @db.VarChar(255)
  email        String?      @db.VarChar(255)
  phone        String?      @db.VarChar(50)
  address      String?      @db.Text
  currency     String       @default("USD") @db.VarChar(10)
  tierId       String?      @map("tier_id") @db.Uuid
  salesRepId   String?      @map("sales_rep_id") @db.Uuid
  ownerId      String?      @map("owner_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  tier             CustomerTier?    @relation(fields: [tierId], references: [id])
  salesRepresentative User?         @relation("SalesRep", fields: [salesRepId], references: [id])
  owner            User?            @relation("CustomerOwner", fields: [ownerId], references: [id])
  quotations       Quotation[]
  negotiations     Negotiation[]
  subscriptions    Subscription[]
  fulfillmentOrders FulfillmentOrder[]

  @@map("customers")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  products        Product[]
  discountRules   DiscountRule[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  sku         String   @unique @db.VarChar(100)
  description String?  @db.Text
  unit        String   @default("unit") @db.VarChar(50)
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  costPrice   Decimal  @map("cost_price") @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  categoryId  String?  @map("category_id") @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  category         Category?        @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  priceListItems   PriceListItem[]
  quotationLines   QuotationLine[]
  warehouseStocks  WarehouseStock[]
  fulfillmentLines FulfillmentLine[]
  subscriptionLines SubscriptionLine[]

  @@map("products")
}

model ProductVariant {
  id              String  @id @default(uuid()) @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  sku             String  @unique @db.VarChar(100)
  attributes      Json    @default("{}")
  priceAdjustment Decimal @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  active          Boolean @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model PriceList {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  currency       String   @default("USD") @db.VarChar(10)
  customerTierId String?  @map("customer_tier_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  customerTier CustomerTier?    @relation(fields: [customerTierId], references: [id])
  items        PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          String @id @default(uuid()) @db.Uuid
  priceListId String @map("price_list_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  price       Decimal @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

// ─── DISCOUNT & APPROVAL MODELS ─────────────────────────────────────────────

model DiscountRule {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  type           String   @db.VarChar(50) // TIER, CATEGORY, VOLUME
  customerTierId String?  @map("customer_tier_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  maxDiscountPct Decimal  @map("max_discount_pct") @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  customerTier CustomerTier? @relation(fields: [customerTierId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])

  @@map("discount_rules")
}

model ApprovalRule {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(255)
  minRiskScore     Int      @map("min_risk_score")
  maxRiskScore     Int      @map("max_risk_score")
  requiredRole     UserRole @map("required_role")
  stepOrder        Int      @map("step_order") @default(1)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("approval_rules")
}

model ApprovalRequest {
  id               String               @id @default(uuid()) @db.Uuid
  quotationId      String               @map("quotation_id") @db.Uuid
  status           ApprovalRequestStatus @default(PENDING)
  riskScore        Int                  @map("risk_score")
  riskLevel        RiskLevel            @map("risk_level")
  currentStep      Int                  @map("current_step") @default(1)
  totalSteps       Int                  @map("total_steps")
  requiredRole     UserRole             @map("required_role")
  reason           String?              @db.Text
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at")

  quotation    Quotation         @relation(fields: [quotationId], references: [id])
  histories    ApprovalHistory[]
  approver     User?             @relation("Approver", fields: [approverId], references: [id])
  approverId   String?           @map("approver_id") @db.Uuid

  @@map("approval_requests")
}

model ApprovalHistory {
  id               String   @id @default(uuid()) @db.Uuid
  approvalRequestId String @map("approval_request_id") @db.Uuid
  action           String   @db.VarChar(50) // APPROVED, REJECTED, RETURNED
  step             Int
  notes            String?  @db.Text
  userId           String   @map("user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  user            User            @relation("ApprovalActionUser", fields: [userId], references: [id])

  @@map("approval_histories")
}

// ─── QUOTATION MODELS ───────────────────────────────────────────────────────

model Quotation {
  id                String          @id @default(uuid()) @db.Uuid
  quotationNumber   String          @unique @map("quotation_number") @db.VarChar(50)
  customerId        String          @map("customer_id") @db.Uuid
  salesRepId        String          @map("sales_rep_id") @db.Uuid
  status            QuotationStatus @default(DRAFT)
  currency          String          @default("USD") @db.VarChar(10)
  subtotal          Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount       Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  totalCost         Decimal         @default(0) @map("total_cost") @db.Decimal(12, 2)
  grossMargin       Decimal         @default(0) @map("gross_margin") @db.Decimal(12, 2)
  marginPercentage  Decimal         @default(0) @map("margin_percentage") @db.Decimal(5, 2)
  validUntil        DateTime?       @map("valid_until")
  notes             String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  salesRepresentative User           @relation("QuotationCreator", fields: [salesRepId], references: [id])
  lines            QuotationLine[]
  approvalRequests ApprovalRequest[]
  negotiations     Negotiation[]
  salesOrder       SalesOrder?

  @@map("quotations")
}

model QuotationLine {
  id              String      @id @default(uuid()) @db.Uuid
  quotationId     String      @map("quotation_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  quantity        Int         @default(1)
  unitPrice       Decimal     @map("unit_price") @db.Decimal(12, 2)
  unitCost        Decimal     @map("unit_cost") @db.Decimal(12, 2)
  discountPercent Decimal     @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate         Decimal     @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal    Decimal     @default(0) @map("line_subtotal") @db.Decimal(12, 2)
  lineTotal       Decimal     @default(0) @map("line_total") @db.Decimal(12, 2)
  marginAmount    Decimal     @default(0) @map("margin_amount") @db.Decimal(12, 2)
  billingType     BillingType @default(ONE_TIME) @map("billing_type")
  createdAt       DateTime    @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_lines")
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation("AuditUser", fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── MODELS FOR DEVELOPER 2 (Fulfillment + Inventory) ──────────────────────

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  location  String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  stocks        WarehouseStock[]
  fulfillmentOrders FulfillmentOrder[]

  @@map("warehouses")
}

model WarehouseStock {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Int      @default(0)
  reservedQty Int      @default(0) @map("reserved_qty")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("warehouse_stocks")
}

model FulfillmentOrder {
  id            String            @id @default(uuid()) @db.Uuid
  orderNumber   String            @unique @map("order_number") @db.VarChar(50)
  quotationId   String?           @map("quotation_id") @db.Uuid
  customerId    String            @map("customer_id") @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  status        FulfillmentStatus @default(PENDING)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")

  customer  Customer          @relation(fields: [customerId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  lines     FulfillmentLine[]
  backorders Backorder[]

  @@map("fulfillment_orders")
}

model FulfillmentLine {
  id               String           @id @default(uuid()) @db.Uuid
  fulfillmentOrderId String         @map("fulfillment_order_id") @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  quantity         Int
  fulfilledQty     Int              @default(0) @map("fulfilled_qty")
  createdAt        DateTime         @default(now()) @map("created_at")

  fulfillmentOrder FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@map("fulfillment_lines")
}

model Backorder {
  id               String           @id @default(uuid()) @db.Uuid
  fulfillmentOrderId String         @map("fulfillment_order_id") @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  quantity         Int
  expectedDate     DateTime?        @map("expected_date")
  status           String           @default("PENDING") @db.VarChar(50)
  createdAt        DateTime         @default(now()) @map("created_at")

  fulfillmentOrder FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id])

  @@map("backorders")
}

// ─── MODELS FOR DEVELOPER 3 (Billing + Subscriptions) ──────────────────────

model SubscriptionPlan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  interval    String   @db.VarChar(50) // MONTHLY, QUARTERLY, YEARLY
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  subscriptionNumber String           @unique @map("subscription_number") @db.VarChar(50)
  customerId       String             @map("customer_id") @db.Uuid
  planId           String?            @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime           @map("start_date")
  endDate          DateTime?          @map("end_date")
  nextBillingDate  DateTime?          @map("next_billing_date")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  customer Customer           @relation(fields: [customerId], references: [id])
  plan     SubscriptionPlan?  @relation(fields: [planId], references: [id])
  lines    SubscriptionLine[]
  billingSchedules BillingSchedule[]
  invoices Invoice[]

  @@map("subscriptions")
}

model SubscriptionLine {
  id              String   @id @default(uuid()) @db.Uuid
  subscriptionId  String   @map("subscription_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Int      @default(1)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  billingType     String   @default("RECURRING") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("subscription_lines")
}

model BillingSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  subscriptionId  String   @map("subscription_id") @db.Uuid
  dueDate         DateTime @map("due_date")
  amount          Decimal  @db.Decimal(12, 2)
  status          String   @default("PENDING") @db.VarChar(50)
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_schedules")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique @map("invoice_number") @db.VarChar(50)
  customerId      String        @map("customer_id") @db.Uuid
  subscriptionId  String?       @map("subscription_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  dueDate         DateTime      @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@map("invoices")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceId   String        @map("invoice_id") @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  method      String?       @db.VarChar(50)
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

// ─── MODELS FOR DEVELOPER 2 (Negotiation) ───────────────────────────────────

model Negotiation {
  id            String   @id @default(uuid()) @db.Uuid
  quotationId   String   @map("quotation_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  status        String   @default("OPEN") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  quotation  Quotation           @relation(fields: [quotationId], references: [id])
  customer   Customer            @relation(fields: [customerId], references: [id])
  messages   NegotiationMessage[]
  changeRequests ChangeRequest[]

  @@map("negotiations")
}

model NegotiationMessage {
  id              String   @id @default(uuid()) @db.Uuid
  negotiationId   String   @map("negotiation_id") @db.Uuid
  senderId        String   @map("sender_id") @db.Uuid
  message         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@map("negotiation_messages")
}

model ChangeRequest {
  id              String   @id @default(uuid()) @db.Uuid
  negotiationId   String   @map("negotiation_id") @db.Uuid
  requestedBy     String   @map("requested_by") @db.Uuid
  changeType      String   @map("change_type") @db.VarChar(50)
  oldValue        Json?    @map("old_value")
  newValue        Json?    @map("new_value")
  status          String   @default("PENDING") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@map("change_requests")
}

// ─── MODELS FOR RECOMMENDATIONS ─────────────────────────────────────────────

model UpsellRule {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  upsellId    String   @map("upsell_id") @db.Uuid
  score       Decimal  @default(0) @db.Decimal(3, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("upsell_rules")
}

model CrossSellRule {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  crossSellId String   @map("cross_sell_id") @db.Uuid
  score       Decimal  @default(0) @db.Decimal(3, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cross_sell_rules")
}

model Recommendation {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String?  @map("customer_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  type        String   @db.VarChar(50) // UPSELL, CROSS_SELL, RENEWAL
  score       Decimal  @db.Decimal(3, 2)
  reason      String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("recommendations")
}

// ─── DEAL HEALTH & ALERTS ───────────────────────────────────────────────────

model DealHealth {
  id              String   @id @default(uuid()) @db.Uuid
  quotationId     String   @map("quotation_id") @db.Uuid
  healthScore     Int      @map("health_score")
  riskFactors     Json?    @map("risk_factors")
  recommendations Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("deal_health")
}

model Alert {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  type        String   @db.VarChar(50)
  message     String   @db.Text
  severity    String   @default("INFO") @db.VarChar(20)
  acknowledged Boolean @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("alerts")
}

// ─── SALES ORDER ────────────────────────────────────────────────────────────

model SalesOrder {
  id              String          @id @default(uuid()) @db.Uuid
  orderNumber     String          @unique @map("order_number") @db.VarChar(50)
  quotationId     String          @unique @map("quotation_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  status          String          @default("PENDING") @db.VarChar(50)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(12, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@map("sales_orders")
