generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
  CONVERTED
  EXPIRED
  CANCELLED
  NEGOTIATION
  CUSTOMER_CONFIRMED
  ORDER_CONFIRMED
  FULFILLMENT
  PARTIALLY_FULFILLED
  FULFILLED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// ─── MODELS ──────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  name          String?   @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  avatarUrl     String?   @map("avatar_url")
  emailVerified Boolean   @default(false) @map("email_verified")
  status        String    @default("active") @db.VarChar(20)
  role          String    @default("CUSTOMER") @db.VarChar(20)
  customerId    String?   @map("customer_id") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  quotations            Quotation[]
  assignedCustomers     Customer[]          @relation("CustomerSalesRep")
  ownedCustomers        Customer[]          @relation("CustomerOwner")
  approvalHistories     ApprovalHistory[]
  assignedApprovals     ApprovalRequest[]   @relation("ApproverUser")
  auditLogs             AuditLog[]

  @@index([role], map: "idx_users_role")
  @@index([email], map: "idx_users_email")
  @@map("users")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")

  products      Product[]
  discountRules DiscountRule[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  sku         String   @unique @db.VarChar(100)
  description String?
  unit        String   @default("unit") @db.VarChar(50)
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  costPrice   Decimal  @map("cost_price") @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  categoryId  String?  @map("category_id") @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  category          Category?          @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  priceListItems    PriceListItem[]
  quotationLines    QuotationLine[]
  warehouseStocks   WarehouseStock[]
  subscriptionLines SubscriptionLine[]
  fulfillmentLines  FulfillmentLine[]
  salesOrderLines   SalesOrderLine[]
  backorders        Backorder[]
  invoiceLines      InvoiceLine[]

  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  sku             String   @unique @db.VarChar(100)
  attributes      Json     @default("{}")
  priceAdjustment Decimal  @default(0) @map("price_adjustment") @db.Decimal(12, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model CustomerTier {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(50)
  description  String?
  discountPct  Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  customers     Customer[]
  discountRules DiscountRule[]
  priceLists    PriceList[]

  @@map("customer_tiers")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  company    String?  @db.VarChar(255)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  address    String?
  currency   String   @default("USD") @db.VarChar(10)
  tierId     String?  @map("tier_id") @db.Uuid
  salesRepId String?  @map("sales_rep_id") @db.Uuid
  ownerId    String?  @map("owner_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  tier              CustomerTier?      @relation(fields: [tierId], references: [id])
  salesRep          User?              @relation("CustomerSalesRep", fields: [salesRepId], references: [id])
  owner             User?              @relation("CustomerOwner", fields: [ownerId], references: [id])
  quotations        Quotation[]
  subscriptions     Subscription[]
  negotiations      Negotiation[]
  fulfillmentOrders FulfillmentOrder[]
  salesOrders       SalesOrder[]
  invoices          Invoice[]

  @@map("customers")
}

model PriceList {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  currency       String   @default("USD") @db.VarChar(10)
  customerTierId String?  @map("customer_tier_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  customerTier CustomerTier?   @relation(fields: [customerTierId], references: [id])
  items        PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          String   @id @default(uuid()) @db.Uuid
  priceListId String   @map("price_list_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

model Quotation {
  id               String          @id @default(uuid()) @db.Uuid
  quotationNumber  String          @unique @map("quotation_number") @db.VarChar(50)
  customerId       String          @map("customer_id") @db.Uuid
  salesRepId       String          @map("sales_rep_id") @db.Uuid
  status           QuotationStatus @default(DRAFT)
  currency         String          @default("USD") @db.VarChar(10)
  subtotal         Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount      Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  totalCost        Decimal         @default(0) @map("total_cost") @db.Decimal(12, 2)
  grossMargin      Decimal         @default(0) @map("gross_margin") @db.Decimal(12, 2)
  marginPercentage Decimal         @default(0) @map("margin_percentage") @db.Decimal(5, 2)
  validUntil       DateTime?       @map("valid_until")
  notes            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  salesRep         User              @relation(fields: [salesRepId], references: [id])
  lines            QuotationLine[]
  approvalRequests ApprovalRequest[]
  negotiations     Negotiation[]
  salesOrder       SalesOrder?

  @@map("quotations")
}

model QuotationLine {
  id              String      @id @default(uuid()) @db.Uuid
  quotationId     String      @map("quotation_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  quantity        Int         @default(1)
  unitPrice       Decimal     @map("unit_price") @db.Decimal(12, 2)
  unitCost        Decimal     @map("unit_cost") @db.Decimal(12, 2)
  discountPercent Decimal     @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate         Decimal     @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal    Decimal     @default(0) @map("line_subtotal") @db.Decimal(12, 2)
  lineTotal       Decimal     @default(0) @map("line_total") @db.Decimal(12, 2)
  marginAmount    Decimal     @default(0) @map("margin_amount") @db.Decimal(12, 2)
  billingType     BillingType @default(ONE_TIME) @map("billing_type")
  createdAt       DateTime    @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_lines")
}

model DiscountRule {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  description    String?
  type           String   @db.VarChar(50)
  customerTierId String?  @map("customer_tier_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  maxDiscountPct Decimal  @map("max_discount_pct") @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  category     Category?     @relation(fields: [categoryId], references: [id])
  customerTier CustomerTier? @relation(fields: [customerTierId], references: [id])

  @@map("discount_rules")
}

model ApprovalRule {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  minRiskScore Int      @map("min_risk_score")
  maxRiskScore Int      @map("max_risk_score")
  requiredRole UserRole @map("required_role")
  stepOrder    Int      @default(1) @map("step_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("approval_rules")
}

model ApprovalRequest {
  id           String                @id @default(uuid()) @db.Uuid
  quotationId  String                @map("quotation_id") @db.Uuid
  status       ApprovalRequestStatus @default(PENDING)
  riskScore    Int                   @map("risk_score")
  riskLevel    RiskLevel             @map("risk_level")
  currentStep  Int                   @default(1) @map("current_step")
  totalSteps   Int                   @map("total_steps")
  requiredRole UserRole              @map("required_role")
  reason       String?
  approverId   String?               @map("approver_id") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")

  quotation Quotation         @relation(fields: [quotationId], references: [id])
  approver  User?             @relation("ApproverUser", fields: [approverId], references: [id])
  history   ApprovalHistory[]

  @@map("approval_requests")
}

model ApprovalHistory {
  id                String   @id @default(uuid()) @db.Uuid
  approvalRequestId String   @map("approval_request_id") @db.Uuid
  action            String   @db.VarChar(50)
  step              Int
  notes             String?
  userId            String   @map("user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@map("approval_histories")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Warehouse {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(255)
  code       String?   @db.VarChar(50)
  location   String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at")

  stocks            WarehouseStock[]
  fulfillmentOrders FulfillmentOrder[]

  @@map("warehouses")
}

model WarehouseStock {
  id           String    @id @default(uuid()) @db.Uuid
  warehouseId  String    @map("warehouse_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  quantity     Int       @default(0)
  reservedQty  Int       @default(0) @map("reserved_qty")
  reorderLevel Int       @default(10) @map("reorder_level")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, productId])
  @@map("warehouse_stocks")
}

model SalesOrder {
  id               String           @id @default(uuid()) @db.Uuid
  orderNumber      String           @unique @map("order_number") @db.VarChar(50)
  quotationId      String           @unique @map("quotation_id") @db.Uuid
  customerId       String           @map("customer_id") @db.Uuid
  status           String           @default("ORDER_CONFIRMED") @db.VarChar(50)
  currency         String           @default("USD") @db.VarChar(10)
  subtotal         Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount      Decimal          @map("total_amount") @db.Decimal(12, 2)
  totalCost        Decimal          @default(0) @map("total_cost") @db.Decimal(12, 2)
  grossMargin      Decimal          @default(0) @map("gross_margin") @db.Decimal(12, 2)
  marginPercentage Decimal          @default(0) @map("margin_percentage") @db.Decimal(5, 2)
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")

  quotation        Quotation          @relation(fields: [quotationId], references: [id])
  customer         Customer           @relation(fields: [customerId], references: [id])
  lines            SalesOrderLine[]
  fulfillments     FulfillmentOrder[]
  invoices         Invoice[]
  subscriptions    Subscription[]
  backorders       Backorder[]

  @@map("sales_orders")
}

model SalesOrderLine {
  id                  String   @id @default(uuid()) @db.Uuid
  salesOrderId        String   @map("sales_order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  quantity            Int      @default(1)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost            Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  discountPercent     Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate             Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal        Decimal  @default(0) @map("line_subtotal") @db.Decimal(12, 2)
  lineTotal           Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  quantityReserved    Int      @default(0) @map("quantity_reserved")
  quantityFulfilled   Int      @default(0) @map("quantity_fulfilled")
  quantityBackordered Int      @default(0) @map("quantity_backordered")
  billingType         String   @default("ONE_TIME") @map("billing_type") @db.VarChar(50)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  salesOrder       SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  fulfillmentLines FulfillmentLine[]
  backorders       Backorder[]

  @@map("sales_order_lines")
}

model SubscriptionPlan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  interval    String   @db.VarChar(50)
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  subscriptionNumber String             @unique @map("subscription_number") @db.VarChar(50)
  customerId         String             @map("customer_id") @db.Uuid
  salesOrderId       String?            @map("sales_order_id") @db.Uuid
  planId             String?            @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  currency           String             @default("USD") @db.VarChar(10)
  startDate          DateTime           @map("start_date")
  endDate            DateTime?          @map("end_date")
  nextBillingDate    DateTime?          @map("next_billing_date")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  customer         Customer           @relation(fields: [customerId], references: [id])
  salesOrder       SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  plan             SubscriptionPlan?  @relation(fields: [planId], references: [id])
  lines            SubscriptionLine[]
  billingSchedules BillingSchedule[]
  invoices         Invoice[]

  @@map("subscriptions")
}

model SubscriptionLine {
  id              String   @id @default(uuid()) @db.Uuid
  subscriptionId  String   @map("subscription_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Int      @default(1)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal       Decimal  @default(0) @map("line_total") @db.Decimal(12, 2)
  billingType     String   @default("RECURRING") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")

  product      Product      @relation(fields: [productId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_lines")
}

model BillingSchedule {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  invoiceId      String?   @map("invoice_id") @db.Uuid
  dueDate        DateTime  @map("due_date")
  amount         Decimal   @db.Decimal(12, 2)
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  status         String    @default("PENDING") @db.VarChar(50)
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@map("billing_schedules")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(50)
  customerId     String        @map("customer_id") @db.Uuid
  salesOrderId   String?       @map("sales_order_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  currency       String        @default("USD") @db.VarChar(10)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue     Decimal       @default(0) @map("balance_due") @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime?     @default(now()) @updatedAt @map("updated_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  salesOrder       SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id])
  payments         Payment[]
  lines            InvoiceLine[]
  billingSchedules BillingSchedule[]

  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  description    String?
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("invoice_lines")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  invoiceId String        @map("invoice_id") @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  method    String?       @db.VarChar(50)
  reference String?       @db.VarChar(100)
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime?     @default(now()) @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Negotiation {
  id         String   @id @default(uuid()) @db.Uuid
  quotationId String   @map("quotation_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  status     String   @default("OPEN") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  customer       Customer             @relation(fields: [customerId], references: [id])
  quotation      Quotation            @relation(fields: [quotationId], references: [id])
  messages       NegotiationMessage[]
  changeRequests ChangeRequest[]

  @@map("negotiations")
}

model NegotiationMessage {
  id            String   @id @default(uuid()) @db.Uuid
  negotiationId String   @map("negotiation_id") @db.Uuid
  senderId      String   @map("sender_id") @db.Uuid
  message       String
  createdAt     DateTime @default(now()) @map("created_at")

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@map("negotiation_messages")
}

model ChangeRequest {
  id            String   @id @default(uuid()) @db.Uuid
  negotiationId String   @map("negotiation_id") @db.Uuid
  requestedBy   String   @map("requested_by") @db.Uuid
  changeType    String   @map("change_type") @db.VarChar(50)
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  status        String   @default("PENDING") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@map("change_requests")
}

model FulfillmentOrder {
  id           String            @id @default(uuid()) @db.Uuid
  orderNumber  String            @unique @map("order_number") @db.VarChar(50)
  quotationId  String?           @map("quotation_id") @db.Uuid
  salesOrderId String?           @map("sales_order_id") @db.Uuid
  customerId   String            @map("customer_id") @db.Uuid
  warehouseId  String            @map("warehouse_id") @db.Uuid
  status       FulfillmentStatus @default(PENDING)
  notes        String?
  fulfilledAt  DateTime?         @map("fulfilled_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  customer   Customer          @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  warehouse  Warehouse         @relation(fields: [warehouseId], references: [id])
  lines      FulfillmentLine[]
  backorders Backorder[]

  @@map("fulfillment_orders")
}

model FulfillmentLine {
  id                 String   @id @default(uuid()) @db.Uuid
  fulfillmentOrderId String   @map("fulfillment_order_id") @db.Uuid
  salesOrderLineId   String?  @map("sales_order_line_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  quantity           Int
  fulfilledQty       Int      @default(0) @map("fulfilled_qty")
  createdAt          DateTime @default(now()) @map("created_at")

  fulfillmentOrder FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  salesOrderLine   SalesOrderLine?  @relation(fields: [salesOrderLineId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])

  @@map("fulfillment_lines")
}

model Backorder {
  id                 String    @id @default(uuid()) @db.Uuid
  fulfillmentOrderId String    @map("fulfillment_order_id") @db.Uuid
  salesOrderId       String?   @map("sales_order_id") @db.Uuid
  salesOrderLineId   String?   @map("sales_order_line_id") @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  quantity           Int
  fulfilledQuantity  Int       @default(0) @map("fulfilled_quantity")
  expectedDate       DateTime? @map("expected_date")
  status             String    @default("PENDING") @db.VarChar(50)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at")

  fulfillmentOrder FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id])
  salesOrder       SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  salesOrderLine   SalesOrderLine?  @relation(fields: [salesOrderLineId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])

  @@map("backorders")
}

model DealHealth {
  id              String   @id @default(uuid()) @db.Uuid
  quotationId     String   @map("quotation_id") @db.Uuid
  healthScore     Int      @map("health_score")
  riskFactors     Json?    @map("risk_factors")
  recommendations Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("deal_health")
}

model Alert {
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(50)
  entityId     String   @map("entity_id") @db.Uuid
  type         String   @db.VarChar(50)
  message      String
  severity     String   @default("INFO") @db.VarChar(20)
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("alerts")
}

model Recommendation {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  type       String   @db.VarChar(50)
  score      Decimal  @db.Decimal(3, 2)
  reason     String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("recommendations")
}

model UpsellRule {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  upsellId   String   @map("upsell_id") @db.Uuid
  score      Decimal  @default(0) @db.Decimal(3, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("upsell_rules")
}

model CrossSellRule {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  crossSellId String   @map("cross_sell_id") @db.Uuid
  score       Decimal  @default(0) @db.Decimal(3, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cross_sell_rules")
}

model Role {
  id                 String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String           @unique @db.VarChar(50)
  displayName        String           @map("display_name") @db.VarChar(100)
  description        String?
  isActive           Boolean?         @default(true) @map("is_active")
  isSelfRegisterable Boolean?         @default(false) @map("is_self_registerable")
  createdAt          DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime?        @default(now()) @map("updated_at") @db.Timestamp(6)

  roleNavigation RoleNavigation[]
  rolePermissions RolePermission[]
  rolePortals    RolePortal?

  @@index([isActive], map: "idx_roles_is_active")
  @@index([isSelfRegisterable], map: "idx_roles_is_self_registerable")
  @@index([name], map: "idx_roles_name")
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  displayName String           @map("display_name") @db.VarChar(150)
  description String?
  isActive    Boolean?         @default(true) @map("is_active")
  createdAt   DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?        @default(now()) @map("updated_at") @db.Timestamp(6)

  rolePermissions RolePermission[]

  @@index([name], map: "idx_permissions_name")
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  roles       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissions Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@index([roleId], map: "idx_role_permissions_role_id")
  @@map("role_permissions")
}

model RolePortal {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roleId      String    @unique @map("role_id") @db.Uuid
  portalName  String    @map("portal_name") @db.VarChar(100)
  portalRoute String    @map("portal_route") @db.VarChar(255)
  isActive    Boolean?  @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  roles Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([roleId], map: "idx_role_portals_role_id")
  @@map("role_portals")
}

model NavigationItem {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String           @db.VarChar(100)
  displayName String           @map("display_name") @db.VarChar(150)
  route       String           @db.VarChar(255)
  icon        String?          @db.VarChar(50)
  parentId    String?          @map("parent_id") @db.Uuid
  sortOrder   Int?             @default(0) @map("sort_order")
  isActive    Boolean?         @default(true) @map("is_active")
  createdAt   DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?        @default(now()) @map("updated_at") @db.Timestamp(6)

  parent   NavigationItem?  @relation("ParentChildNav", fields: [parentId], references: [id], onUpdate: NoAction)
  children NavigationItem[] @relation("ParentChildNav")
  roleNavigation RoleNavigation[]

  @@index([parentId], map: "idx_navigation_items_parent_id")
  @@map("navigation_items")
}

model RoleNavigation {
  roleId           String         @map("role_id") @db.Uuid
  navigationItemId String         @map("navigation_item_id") @db.Uuid

  navigationItems NavigationItem @relation(fields: [navigationItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles           Role           @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, navigationItemId])
  @@index([navigationItemId], map: "idx_role_navigation_nav_id")
  @@index([roleId], map: "idx_role_navigation_role_id")
  @@map("role_navigation")
}
