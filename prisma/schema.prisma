generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserRole {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEGOTIATION
  CUSTOMER_CONFIRMED
  ORDER_CONFIRMED
  FULFILLMENT
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum LineType {
  ONE_TIME
  RECURRING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum FulfillmentStatus {
  PENDING
  ALLOCATED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum BackorderStatus {
  PENDING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceType {
  ONE_TIME
  RECURRING
  PROFORMA
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NegotiationStatus {
  ACTIVE
  AGREED
  CLOSED
}

enum HealthStatus {
  HEALTHY
  AT_RISK
  CRITICAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  PENDING
  ADDED
  DISMISSED
}

enum RuleType {
  UPSELL
  CROSS_SELL
  BUNDLE
}

// ─── MODELS ──────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  password      String?
  role          UserRole  @default(CUSTOMER)
  customerId    String?
  status        String    @default("active")
  avatarUrl     String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer          Customer?          @relation(fields: [customerId], references: [id])
  quotations        Quotation[]
  approvalRequests  ApprovalRequest[]  @relation("RequestedBy")
  assignedApprovals ApprovalRequest[]  @relation("AssignedTo")
  alerts            Alert[]
  auditLogs         AuditLog[]
  negotiationMessages NegotiationMessage[]

  @@index([role])
  @@index([email])
}

model Customer {
  id              String       @id @default(uuid())
  name            String
  companyName     String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String?
  currency        String       @default("USD")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tierId          String?
  tier            CustomerTier? @relation(fields: [tierId], references: [id])
  users           User[]
  quotations      Quotation[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  negotiations    Negotiation[]

  @@index([tierId])
}

model CustomerTier {
  id                   String         @id @default(uuid())
  name                 String         @unique
  description          String?
  defaultDiscountPercent Float        @default(0)

  customers            Customer[]
  discountRules        DiscountRule[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
  discountRules DiscountRule[]
}

model Product {
  id            String    @id @default(uuid())
  sku           String    @unique
  name          String
  description   String?
  unit          String    @default("unit")
  basePrice     Decimal   @db.Decimal(12, 2)
  costPrice     Decimal   @db.Decimal(12, 2)
  taxPercent    Float     @default(0)
  productType   String    @default("standard")
  isSubscription Boolean  @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  priceListItems PriceListItem[]
  warehouseStock WarehouseStock[]
  quotationLines QuotationLine[]
  subscriptionLines SubscriptionLine[]
  recommendations Recommendation[]
  backorders    Backorder[]
  upsellSourceRules  UpsellRule[] @relation("SourceProduct")
  upsellTargetRules  UpsellRule[] @relation("RecommendedProduct")

  @@index([categoryId])
  @@index([sku])
}

model ProductVariant {
  id        String   @id @default(uuid())
  sku       String   @unique
  name      String
  attributes Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quotationLines QuotationLine[]

  @@index([productId])
}

model PriceList {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PriceListItem[]
}

model PriceListItem {
  id          String    @id @default(uuid())
  price       Decimal   @db.Decimal(12, 2)
  minQuantity Int       @default(1)
  maxQuantity Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  @@index([priceListId])
  @@index([productId])
}

model DiscountRule {
  id                  String       @id @default(uuid())
  name                String
  maxDiscountPercent  Float
  approvalRequired    Boolean      @default(false)
  approvalLevel       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  customerTierId      String?
  customerTier        CustomerTier? @relation(fields: [customerTierId], references: [id])
  categoryId          String?
  category            Category?    @relation(fields: [categoryId], references: [id])

  @@index([customerTierId])
  @@index([categoryId])
}

model ApprovalRule {
  id              String  @id @default(uuid())
  name            String
  minAmount       Decimal @db.Decimal(12, 2)
  maxAmount       Decimal?
  riskThreshold   Float?
  requiredLevel   String
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  approvalRequests ApprovalRequest[]
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  level         String
  status        ApprovalStatus @default(PENDING)
  riskScore     Float?
  reason        String?
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?

  quotationId   String
  quotation     Quotation      @relation(fields: [quotationId], references: [id])
  requestedById String
  requestedBy   User           @relation("RequestedBy", fields: [requestedById], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation("AssignedTo", fields: [assignedToId], references: [id])
  approvalRuleId String?
  approvalRule  ApprovalRule?  @relation(fields: [approvalRuleId], references: [id])

  history       ApprovalHistory[]

  @@index([quotationId])
  @@index([status])
}

model ApprovalHistory {
  id                String          @id @default(uuid())
  action            String
  comments          String?
  createdAt         DateTime        @default(now())

  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id])

  @@index([approvalRequestId])
}

model Warehouse {
  id                  String  @id @default(uuid())
  name                String
  code                String  @unique
  address             String?
  city                String?
  country             String?
  shippingCostWeight  Float?
  isActive            Boolean @default(true)

  stock               WarehouseStock[]
  fulfillmentOrders   FulfillmentOrder[]
}

model WarehouseStock {
  id                String    @id @default(uuid())
  availableQuantity Int       @default(0)
  reservedQuantity  Int       @default(0)
  reorderLevel      Int       @default(0)
  updatedAt         DateTime  @updatedAt

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Quotation {
  id                String           @id @default(uuid())
  quotationNumber   String           @unique
  status            QuotationStatus  @default(DRAFT)
  currency          String           @default("USD")
  subtotal          Decimal          @default(0) @db.Decimal(12, 2)
  discountTotal     Decimal          @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal          @default(0) @db.Decimal(12, 2)
  totalCost         Decimal          @default(0) @db.Decimal(12, 2)
  grossMargin       Decimal          @default(0) @db.Decimal(12, 2)
  grossMarginPercent Float           @default(0)
  discountRiskScore Float?
  approvalRequired  Boolean          @default(false)
  validUntil        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  confirmedAt       DateTime?

  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  salesRepId        String
  salesRep          User             @relation(fields: [salesRepId], references: [id])

  lines             QuotationLine[]
  approvalRequests  ApprovalRequest[]
  fulfillmentOrders FulfillmentOrder[]
  backorders        Backorder[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  recommendations   Recommendation[]
  negotiations      Negotiation[]
  dealHealth        DealHealth?
  alerts            Alert[]

  @@index([customerId])
  @@index([salesRepId])
  @@index([status])
  @@index([createdAt])
}

model QuotationLine {
  id              String     @id @default(uuid())
  description     String?
  quantity        Int
  unitPrice       Decimal    @db.Decimal(12, 2)
  costPrice       Decimal    @db.Decimal(12, 2)
  discountPercent Float      @default(0)
  discountAmount  Decimal    @default(0) @db.Decimal(12, 2)
  taxPercent      Float      @default(0)
  subtotal        Decimal    @default(0) @db.Decimal(12, 2)
  total           Decimal    @default(0) @db.Decimal(12, 2)
  margin          Decimal    @default(0) @db.Decimal(12, 2)
  marginPercent   Float      @default(0)
  lineType        LineType   @default(ONE_TIME)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  quotationId     String
  quotation       Quotation  @relation(fields: [quotationId], references: [id])
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  fulfillmentLines FulfillmentLine[]
  backorders      Backorder[]
  subscriptionLines SubscriptionLine[]
  negotiationMessages NegotiationMessage[]

  @@index([quotationId])
  @@index([productId])
}

model FulfillmentOrder {
  id                    String           @id @default(uuid())
  status                FulfillmentStatus @default(PENDING)
  shippingCost          Decimal          @default(0) @db.Decimal(12, 2)
  expectedDeliveryDate  DateTime?
  createdAt             DateTime         @default(now())

  quotationId     String
  quotation       Quotation     @relation(fields: [quotationId], references: [id])
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  lines           FulfillmentLine[]

  @@index([quotationId])
  @@index([status])
}

model FulfillmentLine {
  id                  String          @id @default(uuid())
  quantity            Int

  fulfillmentOrderId  String
  fulfillmentOrder    FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id])
  quotationLineId     String
  quotationLine       QuotationLine    @relation(fields: [quotationLineId], references: [id])
}

model Backorder {
  id                  String          @id @default(uuid())
  requestedQuantity   Int
  fulfilledQuantity   Int             @default(0)
  remainingQuantity   Int
  expectedDate        DateTime?
  status              BackorderStatus @default(PENDING)

  quotationId     String
  quotation       Quotation  @relation(fields: [quotationId], references: [id])
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  quotationLineId String
  quotationLine   QuotationLine @relation(fields: [quotationLineId], references: [id])

  @@index([quotationId])
  @@index([status])
}

model SubscriptionPlan {
  id                  String   @id @default(uuid())
  name                String
  billingInterval     String
  price               Decimal  @db.Decimal(12, 2)
  currency            String   @default("USD")
  prorationEnabled    Boolean  @default(false)
  cancellationPolicy  String?
  refundPolicy        String?
  isActive            Boolean  @default(true)

  subscriptions       Subscription[]
}

model Subscription {
  id                    String           @id @default(uuid())
  status                SubscriptionStatus @default(ACTIVE)
  startDate             DateTime
  endDate               DateTime?
  nextBillingDate       DateTime?
  billingInterval       String
  totalRecurringAmount  Decimal          @default(0) @db.Decimal(12, 2)
  createdAt             DateTime         @default(now())

  quotationId   String
  quotation     Quotation      @relation(fields: [quotationId], references: [id])
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  planId        String?
  plan          SubscriptionPlan? @relation(fields: [planId], references: [id])
  lines         SubscriptionLine[]
  billingSchedules BillingSchedule[]

  @@index([customerId])
  @@index([status])
}

model SubscriptionLine {
  id              String   @id @default(uuid())
  quantity        Int
  recurringPrice  Decimal  @db.Decimal(12, 2)
  billingInterval String

  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id])
  quotationLineId  String?
  quotationLine    QuotationLine? @relation(fields: [quotationLineId], references: [id])
  productId        String
  product          Product      @relation(fields: [productId], references: [id])
}

model BillingSchedule {
  id          String        @id @default(uuid())
  billingDate DateTime
  amount      Decimal       @db.Decimal(12, 2)
  status      BillingStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([subscriptionId])
  @@index([status])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  invoiceType   InvoiceType   @default(ONE_TIME)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  quotationId   String?
  quotation     Quotation?    @relation(fields: [quotationId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  payments      Payment[]
  billingSchedules BillingSchedule[]

  @@index([customerId])
  @@index([status])
}

model Payment {
  id                    String        @id @default(uuid())
  amount                Decimal       @db.Decimal(12, 2)
  paymentMethod         String?
  transactionReference  String?
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?

  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

model UpsellRule {
  id                    String  @id @default(uuid())
  ruleType              RuleType @default(UPSELL)
  priority              Int     @default(0)
  minimumMarginPercent  Float?
  promotionText         String?
  isActive              Boolean @default(true)

  sourceProductId       String
  sourceProduct         Product @relation("SourceProduct", fields: [sourceProductId], references: [id])
  recommendedProductId  String
  recommendedProduct    Product @relation("RecommendedProduct", fields: [recommendedProductId], references: [id])

  @@index([sourceProductId])
}

model Recommendation {
  id                  String               @id @default(uuid())
  score               Float                @default(0)
  expectedMarginDelta Float?
  reason              String?
  promotionText       String?
  status              RecommendationStatus @default(PENDING)
  createdAt           DateTime             @default(now())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([status])
}

model Negotiation {
  id          String             @id @default(uuid())
  status      NegotiationStatus  @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  customerId  String
  customer    Customer? @relation(fields: [customerId], references: [id])

  messages    NegotiationMessage[]

  @@index([quotationId])
}

model NegotiationMessage {
  id                     String   @id @default(uuid())
  message                String?
  requestedDiscountPercent Float?
  createdAt              DateTime @default(now())

  negotiationId    String
  negotiation      Negotiation     @relation(fields: [negotiationId], references: [id])
  senderUserId     String
  senderUser       User            @relation(fields: [senderUserId], references: [id])
  quotationLineId  String?
  quotationLine    QuotationLine?  @relation(fields: [quotationLineId], references: [id])

  @@index([negotiationId])
}

model DealHealth {
  id                String       @id @default(uuid())
  healthScore       Float        @default(0)
  healthStatus      HealthStatus @default(HEALTHY)
  daysStalled       Int          @default(0)
  discountAnomaly   Boolean      @default(false)
  deliveryRisk      Boolean      @default(false)
  approvalDelay     Boolean      @default(false)
  lastCalculatedAt  DateTime     @default(now())

  quotationId String   @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])
}

model Alert {
  id         String        @id @default(uuid())
  type       String
  severity   AlertSeverity @default(MEDIUM)
  title      String
  message    String?
  isRead     Boolean       @default(false)
  createdAt  DateTime      @default(now())

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([quotationId])
  @@index([isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
